{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::usms-student-data"
    },
    {
      "Sid": "ReadTranscriptsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::usms-student-data/transcripts/*"
    },
    {
      "Sid": "DenyWritesAndDeletes",
      "Effect": "Deny",
      "Action": ["s3:Put*", "s3:Delete*"],
      "Resource": ["arn:aws:s3:::usms-student-data", "arn:aws:s3:::usms-student-data/*"]
    }
  ]
}
